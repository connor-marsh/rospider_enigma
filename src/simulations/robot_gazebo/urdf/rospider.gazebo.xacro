<?xml version="1.0" encoding="utf-8"?>
<!--
  MIGRATED Humble to Jazzy.

  REMOVED: <param name="mimic"> and <param name="multiplier"> from every joint.
  Jazzy's ros2_control deleted these; mimic is now read ONLY from the <mimic>
  tag in the URDF joint definition (rospider_description/urdf/gripper.urdf.xacro).

  !! ACTION REQUIRED - the two sources DISAGREED, so behavior will change !!

      joint        | this file said  | gripper.urdf.xacro says
      l_joint      | r_joint x (-1)  | r_joint x (-1)   agree
      l_in_joint   | l_joint x (+1)  | r_joint x (-1)   agree, via l_joint
      l_out_joint  | l_joint x (+1)  | r_joint x (-1)   agree, via l_joint
      r_in_joint   | r_joint x (+1)  | r_joint x (-1)   CONFLICT
      r_out_joint  | r_joint x (-1)  | r_joint x (+1)   CONFLICT

  On Humble this file won. On Jazzy the URDF wins, so r_in_joint and
  r_out_joint will move in the OPPOSITE direction from before. Decide which
  is correct and edit the <mimic> tags in gripper.urdf.xacro accordingly.
-->
<robot name="arm" xmlns:xacro="http://ros.org/wiki/xacro">
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-3.14159</param> <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-2.09</param>
        <param name="max">2.09</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-2.09</param>
        <param name="max">2.09</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position">
        <param name="min">-2.09</param>
        <param name="max">2.09</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position">
        <param name="min">-2.09</param>
        <param name="max">2.09</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="r_joint"> <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="l_joint"><state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="l_in_joint"><state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="l_out_joint"><state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="r_in_joint"><state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="r_out_joint"><state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="coxa_LF_joint">
      <command_interface name="position">
         <param name="min">-1</param> <param name="max">1.5</param> </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="femur_LF_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tibla_LF_joint">
      <command_interface name="position">
         <param name="min">-1.35</param> <param name="max">0</param> </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="coxa_LM_joint">
      <command_interface name="position">
         <param name="min">-1</param> <param name="max">1.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="femur_LM_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tibla_LM_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.35</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="coxa_LR_joint">
      <command_interface name="position">
         <param name="min">-1</param> <param name="max">1.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="femur_LR_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tibla_LR_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.375</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="coxa_RF_joint">
      <command_interface name="position">
         <param name="min">-1.5</param> <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="femur_RF_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tibla_RF_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.375</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="coxa_RM_joint">
      <command_interface name="position">
         <param name="min">-1</param> <param name="max">1.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="femur_RM_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tibla_RM_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.375</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="coxa_RR_joint">
      <command_interface name="position">
         <param name="min">-1</param> <param name="max">1.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="femur_RR_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.75</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="tibla_RR_joint">
      <command_interface name="position">
         <param name="min">-1.75</param> <param name="max">1.375</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>

</robot>